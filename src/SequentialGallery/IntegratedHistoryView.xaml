<UserControl x:Class="SequentialGallery.IntegratedHistoryView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SequentialGallery"
 Background="#151A21" Foreground="White">
 <Grid>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="350"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="240"/></Grid.ColumnDefinitions>
  <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="8">
   <WrapPanel>
    <TextBlock Text="Completed choice in preview: " VerticalAlignment="Center"/>
    <ComboBox x:Name="CompletedChoice" MinWidth="170" Margin="4" DisplayMemberPath="Label"/>
    <Button x:Name="ChooseFinalButton" Content="Use for final rendering" Padding="12,8" Margin="4" Click="ChooseFinalClick" IsEnabled="False"/>
   </WrapPanel>
   <WrapPanel>
    <TextBlock x:Name="FinalSelectionLabel" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4" MaxWidth="680"/>
    <Button x:Name="OpenFinalButton" Content="Configure final rendering" Padding="12,8" Margin="4" Click="OpenFinalClick" IsEnabled="False"/>
   </WrapPanel>
  </StackPanel>
  <DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="8">
    <TextBlock Text="Connected exploration history" FontSize="19" FontWeight="SemiBold"/>
    <TextBlock Text="Green = active · Purple = preview · Gold = shape reference. Click to preview; drag empty space or middle-drag to pan, wheel to zoom." TextWrapping="Wrap" Foreground="#AAB8C8" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8">
    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <Slider x:Name="ZoomSlider" Width="160" Minimum="0.25" Maximum="1.8" Value="0.8" ValueChanged="ZoomChanged"/>
    <TextBlock x:Name="ZoomLabel" Margin="8,0" VerticalAlignment="Center"/>
   </StackPanel>
   <ScrollViewer x:Name="GraphScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#10151C"
    PreviewMouseWheel="GraphWheel" PreviewMouseDown="PanStart" PreviewMouseMove="PanMove" PreviewMouseUp="PanEnd">
    <Canvas x:Name="GraphCanvas" Background="Transparent"/>
   </ScrollViewer>
  </DockPanel>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#526174" ResizeBehavior="PreviousAndNext"/>
  <Grid Grid.Column="2" Background="#1D2530">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="PreviewTitle" Text="Select a history node" Margin="12" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <local:ImageViewport x:Name="PreviewView" Grid.Row="1" Margin="12,0">
    <Image x:Name="PreviewImage" Stretch="Fill"/>
   </local:ImageViewport>
   <TextBox x:Name="PreviewDetails" Grid.Row="2" Margin="12" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#222B36" Foreground="White" Padding="6"/>
   <Button x:Name="ResumeButton" Grid.Row="3" Content="Resume from here" Margin="12" Padding="12,8" Background="#3C315B" Foreground="White" Click="ResumeClick" IsEnabled="False"/>
  </Grid>
 </Grid>
</UserControl>
