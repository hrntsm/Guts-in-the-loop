<Window x:Class="SequentialGallery.GalleryWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sequential Gallery" Width="1100" Height="850" MinWidth="650" MinHeight="500"
 Background="#151A21" Foreground="#F3F5F7" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#283341"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="Margin" Value="4"/>
  </Style>
 </Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
   <TextBlock Text="SEQUENTIAL GALLERY" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock x:Name="PlaneLabel" Text="Setup" Margin="0,8,0,0"/>
   <TextBlock x:Name="GalleryInstructions" Visibility="Collapsed" Text="Select the design you prefer. Four selections advance to a new search plane." Foreground="#AAB8C8" Margin="0,5,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="5"/>
   <TextBlock x:Name="Status" Margin="4,8" TextWrapping="Wrap" Text="Choose a grid size, then start exploration. Slider values stay unchanged until you start."/>
   <DockPanel>
    <Button x:Name="CancelButton" Content="Close" Click="CancelClick" DockPanel.Dock="Left"/>
    <Button x:Name="FinishButton" Visibility="Collapsed" Content="Finish with selected design" Click="FinishClick" DockPanel.Dock="Right" IsEnabled="False"/>
    <TextBlock x:Name="SessionHint" Visibility="Collapsed" Text="Keep the source documents open. Camera and capture size stay fixed." VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap" Foreground="#AAB8C8"/>
   </DockPanel>
  </StackPanel>
  <Grid>
   <StackPanel x:Name="SetupPanel" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
    <TextBlock Text="Set up exploration" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="Rows" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <ComboBox x:Name="RowsChoice" Width="65" SelectedIndex="1" SelectionChanged="GridSizeChanged" VerticalContentAlignment="Center">
      <ComboBoxItem Content="3"/><ComboBoxItem Content="5"/><ComboBoxItem Content="7"/><ComboBoxItem Content="9"/>
     </ComboBox>
     <TextBlock Text="Columns" VerticalAlignment="Center" Margin="16,0,8,0"/>
     <ComboBox x:Name="ColumnsChoice" Width="65" SelectedIndex="1" SelectionChanged="GridSizeChanged" VerticalContentAlignment="Center">
      <ComboBoxItem Content="3"/><ComboBoxItem Content="5"/><ComboBoxItem Content="7"/><ComboBoxItem Content="9"/>
     </ComboBox>
     <TextBlock x:Name="GridSummary" VerticalAlignment="Center" Margin="16,0"/>
     <Button x:Name="StartButton" Content="Start exploration" Click="StartClick"/>
    </WrapPanel>
    <TextBlock x:Name="TimeEstimate" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock Text="Estimate uses the last solution duration × image count. Viewport redraw, image capture and SPS add time; solve cost can vary, and out-of-range slots are skipped." TextWrapping="Wrap" Foreground="#AAB8C8" Margin="0,4,0,0"/>
    <TextBlock Text="Uses the active Rhino viewport and camera when you press Start. Frame your model first. Odd grid sizes keep a center candidate; larger grids take longer." TextWrapping="Wrap" Foreground="#AAB8C8" Margin="0,8,0,0"/>
   </StackPanel>
   <UniformGrid x:Name="Gallery" Visibility="Collapsed" Rows="5" Columns="5"/>
  </Grid>
 </DockPanel>
</Window>
