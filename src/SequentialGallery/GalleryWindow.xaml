<Window x:Class="SequentialGallery.GalleryWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sequential Gallery" Width="1100" Height="850" MinWidth="650" MinHeight="500"
 Background="#151A21" Foreground="#F3F5F7" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#283341"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="Margin" Value="4"/>
  </Style>
 </Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
   <TextBlock Text="SEQUENTIAL GALLERY" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock x:Name="PlaneLabel" Margin="0,8,0,0"/>
   <TextBlock Text="Select the design you prefer. Four selections advance to a new search plane." Foreground="#AAB8C8" Margin="0,5,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <ProgressBar x:Name="Progress" Height="5" Maximum="25"/>
   <TextBlock x:Name="Status" Margin="4,8" TextWrapping="Wrap"/>
   <DockPanel>
    <Button x:Name="CancelButton" Content="Cancel / Close" Click="CancelClick" DockPanel.Dock="Left"/>
    <Button x:Name="FinishButton" Content="Finish with selected design" Click="FinishClick" DockPanel.Dock="Right" IsEnabled="False"/>
    <TextBlock Text="Keep the source documents open. Camera and capture size stay fixed." VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap" Foreground="#AAB8C8"/>
   </DockPanel>
  </StackPanel>
  <UniformGrid x:Name="Gallery" Rows="5" Columns="5"/>
 </DockPanel>
</Window>
