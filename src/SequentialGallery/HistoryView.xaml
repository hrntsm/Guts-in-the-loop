<UserControl x:Class="SequentialGallery.HistoryView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#151A21" Foreground="White">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="200"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="220"/></Grid.ColumnDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="4,4,4,10">
    <TextBlock Text="Exploration history" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="Click to preview. Green = active; purple = preview. Drag empty space or middle-drag to pan; use the wheel to zoom." TextWrapping="Wrap" Foreground="#AAB8C8" Margin="0,4,0,0"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4,8,4,0">
    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <Slider x:Name="ZoomSlider" Width="160" Minimum="0.35" Maximum="1.8" Value="0.8" ValueChanged="ZoomChanged"/>
    <TextBlock x:Name="ZoomLabel" Text="80%" VerticalAlignment="Center" Margin="8,0"/>
   </StackPanel>
   <ScrollViewer x:Name="GraphScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#10151C"
    PreviewMouseWheel="GraphWheel" PreviewMouseDown="PanStart" PreviewMouseMove="PanMove" PreviewMouseUp="PanEnd">
    <Canvas x:Name="GraphCanvas" Background="Transparent"/>
   </ScrollViewer>
  </DockPanel>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#526174" ResizeBehavior="PreviousAndNext"/>
  <Grid Grid.Column="2" Background="#1D2530" Margin="0,0,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="PreviewTitle" Text="Select a history node" Margin="12" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <Image x:Name="PreviewImage" Grid.Row="1" Margin="12,0" Stretch="Uniform"/>
   <TextBox x:Name="PreviewDetails" Grid.Row="2" Margin="12" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#222B36" Foreground="White" Padding="6"/>
   <Button x:Name="ResumeButton" Grid.Row="3" Content="Resume from here" Margin="12" Padding="12,8" Background="#3C315B" Foreground="White" Click="ResumeClick" IsEnabled="False"/>
  </Grid>
 </Grid>
</UserControl>
